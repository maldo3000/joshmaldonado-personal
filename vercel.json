{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/software-is-a-medium/",
      "destination": "/software-is-a-medium/index.html"
    },
    {
      "source": "/fitc-deck/",
      "destination": "/fitc-deck/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/software-is-a-medium",
      "destination": "/software-is-a-medium/",
      "permanent": true
    },
    {
      "source": "/fitc-deck",
      "destination": "/fitc-deck/",
      "permanent": true
    },
    {
      "source": "/cut-from-paper",
      "destination": "/software-is-a-medium/",
      "permanent": true
    },
    {
      "source": "/cut-from-paper/",
      "destination": "/software-is-a-medium/",
      "permanent": true
    },
    {
      "source": "/cut-from-paper/:path*",
      "destination": "/software-is-a-medium/:path*",
      "permanent": true
    }
  ]
}
