{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/cut-from-paper/",
      "destination": "/cut-from-paper/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/cut-from-paper",
      "destination": "/cut-from-paper/",
      "permanent": true
    }
  ]
}
